// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())
  email String @unique
  role UserRole @default(USER)
  name String?
  password String?
  googleId String?
  userPhoto String?
  createdAt DateTime @default(now())

  refreshToken RefreshToken[]
  savedBlogs SavedBlog[]
  blogUpvotes BlogUpvote[] @relation("UserBlogUpvotes")
  blogDownvotes BlogDownvote[] @relation("UserBlogDownvotes")
  readingHistory ReadingHistory[]
  lists List[]
  followedTopics FollowedTopic[]
  comments Comment[]
  commentUpvotes CommentUpvote[] @relation("UserCommentUpvotes")
  commentDownvotes CommentDownvote[] @relation("UserCommentDownvotes")
  adminProfile AdminUser?
}

model RefreshToken {
  id String @id @default(uuid())
  token String @unique
  userId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Blog {
  id String @id @default(uuid())
  title String
  description String?
  content String?
  sourceURL String @unique
  sourceSite String
  author String?
  publishedAt DateTime?
  readTime Int?
  thumbnail String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  searchVector Unsupported("tsvector")?

  tag BlogTag[]
  savedBy SavedBlog[]
  upvotes BlogUpvote[] @relation("BlogUpvotes")
  downvotes BlogDownvote[] @relation("BlogDownvotes")
  comments Comment[]
  history ReadingHistory[]
  listBlog ListBlog[]
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique

  blogs BlogTag[]
  followedBy FollowedTopic[]
}

model BlogTag {
  blogId String
  tagId  String

  blog Blog @relation(fields: [blogId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([blogId, tagId])
}

model SavedBlog {
  id     String @id @default(uuid())
  userId String
  blogId String

  user User @relation(fields: [userId], references: [id])
  blog Blog @relation(fields: [blogId], references: [id])

  @@unique([userId, blogId])
}

model BlogUpvote {
  id String @id @default(uuid())
  userId String
  blogId String
  createdAt DateTime @default(now())

  user User @relation("UserBlogUpvotes", fields: [userId], references: [id])
  blog Blog @relation("BlogUpvotes", fields: [blogId], references: [id])

  @@unique([userId, blogId])
}

model BlogDownvote {
  id String @id @default(uuid())
  userId String
  blogId String
  createdAt DateTime @default(now())

  user User @relation("UserBlogDownvotes", fields: [userId], references: [id])
  blog Blog @relation("BlogDownvotes", fields: [blogId], references: [id])

  @@unique([userId, blogId])
}

model ReadingHistory {
  id        String   @id @default(uuid())
  userId    String
  blogId    String
  readAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  blog Blog @relation(fields: [blogId], references: [id])
}

model Comment {
  id String @id @default(uuid())
  userId String
  blogId String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  blog Blog @relation(fields: [blogId], references: [id])
  upvotes CommentUpvote[] @relation("CommentUpvotes")
  downvotes CommentDownvote[] @relation("CommentDownvotes")
}

model CommentUpvote {
  id String @id @default(uuid())
  userId String
  commentId String
  createdAt DateTime @default(now())

  user User @relation("UserCommentUpvotes", fields: [userId], references: [id])
  comment Comment @relation("CommentUpvotes", fields: [commentId], references: [id])

  @@unique([userId, commentId])
}

model CommentDownvote {
  id String @id @default(uuid())
  userId String
  commentId String
  createdAt DateTime @default(now())

  user User @relation("UserCommentDownvotes", fields: [userId], references: [id])
  comment Comment @relation("CommentDownvotes", fields: [commentId], references: [id])

  @@unique([userId, commentId])
}

model List {
  id     String @id @default(uuid())
  name   String
  userId String

  user User @relation(fields: [userId], references: [id])
  blogs ListBlog[]
}

model ListBlog {
  id     String @id @default(uuid())
  listId String
  blogId String

  list List @relation(fields: [listId], references: [id])
  blog Blog @relation(fields: [blogId], references: [id])
}

model FollowedTopic {
  id String @id @default(uuid())
  userId String
  tagId String

  user User @relation(fields:[userId],references:[id])
  tag Tag @relation(fields:[tagId],references:[id])
}

model AdminUser {
  id String @id @default(uuid())
  username String @unique
  passwordHash String
  userId String? @unique
  user User? @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}